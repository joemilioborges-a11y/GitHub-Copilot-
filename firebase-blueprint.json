{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public profile information for a JOBS platform user or creator without sensitive PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public display name.",
          "minLength": 1,
          "maxLength": 100
        },
        "handle": {
          "type": "string",
          "description": "Unique public username handle.",
          "minLength": 2,
          "maxLength": 50,
          "pattern": "^[a-zA-Z0-9_\\-@\\.]+$"
        },
        "avatarUrl": {
          "type": "string",
          "description": "URL for public avatar image.",
          "maxLength": 500
        },
        "bio": {
          "type": "string",
          "description": "Short biography.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["uid", "displayName", "handle", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly isolated PII document accessible only by the owner or verified administrators.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner UID matching parent user document.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address of the user.",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "AdminAuditRecord": {
      "title": "AdminAuditRecord",
      "description": "Immutable administrative activity audit event anchored with SHA-256 hash chain.",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "description": "Unique identifier of the audit event.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorId": {
          "type": "string",
          "description": "UID of the administrator who executed the action.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "action": {
          "type": "string",
          "description": "Action category executed.",
          "minLength": 2,
          "maxLength": 64
        },
        "targetType": {
          "type": "string",
          "description": "Affected resource type.",
          "minLength": 2,
          "maxLength": 64
        },
        "targetId": {
          "type": "string",
          "description": "Identifier of the affected resource.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "result": {
          "type": "string",
          "enum": ["success", "failure", "denied"],
          "description": "Outcome of the administrative operation."
        },
        "reason": {
          "type": "string",
          "description": "Justification for the action.",
          "minLength": 1,
          "maxLength": 500
        },
        "eventHash": {
          "type": "string",
          "description": "SHA-256 canonical hash of the event.",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "previousEventHash": {
          "type": "string",
          "description": "SHA-256 hash of the preceding event in the chain.",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        }
      },
      "required": [
        "eventId",
        "actorId",
        "action",
        "targetType",
        "targetId",
        "result",
        "reason",
        "eventHash",
        "previousEventHash",
        "createdAt"
      ]
    },
    "LedgerSnapshot": {
      "title": "LedgerSnapshot",
      "description": "Immutable double-entry financial ledger entry persisted in Firestore.",
      "type": "object",
      "properties": {
        "entryId": {
          "type": "string",
          "description": "Unique identifier of the ledger entry.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorId": {
          "type": "string",
          "description": "UID of the user or administrator associated with the entry.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "operationType": {
          "type": "string",
          "description": "Accounting operation type.",
          "minLength": 2,
          "maxLength": 64
        },
        "debitAccount": {
          "type": "string",
          "description": "Debited account identifier.",
          "minLength": 2,
          "maxLength": 128
        },
        "creditAccount": {
          "type": "string",
          "description": "Credited account identifier.",
          "minLength": 2,
          "maxLength": 128
        },
        "amountCents": {
          "type": "number",
          "description": "Monetary value in integer cents or credits."
        },
        "currency": {
          "type": "string",
          "enum": ["BRL", "CREDITS"],
          "description": "Currency scope of the entry."
        },
        "status": {
          "type": "string",
          "enum": ["posted", "pending", "voided", "refunded"],
          "description": "Accounting status of the entry."
        },
        "entryHash": {
          "type": "string",
          "description": "SHA-256 hash of the ledger entry.",
          "minLength": 16,
          "maxLength": 128
        },
        "previousHash": {
          "type": "string",
          "description": "Hash of the preceding ledger entry.",
          "minLength": 16,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        }
      },
      "required": [
        "entryId",
        "actorId",
        "operationType",
        "debitAccount",
        "creditAccount",
        "amountCents",
        "currency",
        "status",
        "entryHash",
        "previousHash",
        "createdAt"
      ]
    },
    "TestAuditProbe": {
      "title": "TestAuditProbe",
      "description": "Diagnostic probe document in test_audit collection used to validate Firebase initialization and access permissions.",
      "type": "object",
      "properties": {
        "probeId": {
          "type": "string",
          "description": "Identifier of the diagnostic probe.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorId": {
          "type": "string",
          "description": "UID of the authenticated user or administrator who wrote the probe.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["ok", "active"],
          "description": "Status of the diagnostic probe."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["probeId", "actorId", "status", "createdAt", "updatedAt"]
    },
    "ProtectedMediaItem": {
      "title": "ProtectedMediaItem",
      "description": "Metadata for creator photos, videos, and VIP Vault items with server/admin-enforced moderation status.",
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "description": "Unique identifier of the media item.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "creatorId": {
          "type": "string",
          "description": "UID of the creator who owns the media item.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mediaType": {
          "type": "string",
          "enum": ["photo", "video"],
          "description": "Type of media asset."
        },
        "visibility": {
          "type": "string",
          "enum": ["free", "paid", "vip_vault"],
          "description": "Access tier of the media asset."
        },
        "priceDiamonds": {
          "type": "number",
          "description": "Unlock price in integer diamonds (0, 49, or 99)."
        },
        "moderationStatus": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Moderation state. Creators can only set pending; only admins can set approved or rejected."
        },
        "title": {
          "type": "string",
          "description": "Optional media title.",
          "maxLength": 140
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "mediaId",
        "creatorId",
        "mediaType",
        "visibility",
        "priceDiamonds",
        "moderationStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "TalentProgressSnapshot": {
      "title": "TalentProgressSnapshot",
      "description": "Audited gamification and challenge progress snapshot for a JOBS participant in production mode, strictly isolated from financial ledger entries.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated UID of the participant.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["produtor_conteudo", "colaborador"],
          "description": "Active participant perspective."
        },
        "environmentMode": {
          "type": "string",
          "enum": ["production"],
          "description": "Must strictly be production; simulation snapshots are forbidden in Firestore."
        },
        "approvedPublishedMediaCount": {
          "type": "number",
          "description": "Audited count of published and approved media items."
        },
        "collaboratorVerifiedActionsCount": {
          "type": "number",
          "description": "Audited count of verified collaborator/referral actions."
        },
        "eligibleMutualAndChatInteractionsCount": {
          "type": "number",
          "description": "Audited count of mutual matches and eligible chat interactions."
        },
        "validLiveSessionsCount": {
          "type": "number",
          "description": "Audited count of valid live stream sessions."
        },
        "weeklyActiveDaysCount": {
          "type": "number",
          "description": "Audited count of distinct active days in the week (0 to 7)."
        },
        "eligibleEngagementEventsCount": {
          "type": "number",
          "description": "Audited count of eligible engagement events."
        },
        "pontosConquistados": {
          "type": "number",
          "description": "Gamification points earned from audited progress (non-monetary)."
        },
        "levelNumber": {
          "type": "number",
          "description": "Current gamification level (1 to 10)."
        },
        "desafiosConcluidosCount": {
          "type": "number",
          "description": "Number of completed challenges in the current cycle (0 to 5)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial snapshot creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last audited synchronization."
        }
      },
      "required": [
        "userId",
        "role",
        "environmentMode",
        "approvedPublishedMediaCount",
        "collaboratorVerifiedActionsCount",
        "eligibleMutualAndChatInteractionsCount",
        "validLiveSessionsCount",
        "weeklyActiveDaysCount",
        "eligibleEngagementEventsCount",
        "pontosConquistados",
        "levelNumber",
        "desafiosConcluidosCount",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserPublicProfile",
      "description": "Stores public profile information for users and creators."
    },
    "/users/{userId}/private/{docId}": {
      "schema": "UserPrivateInfo",
      "description": "Stores isolated PII (email) strictly restricted to the user or verified administrators."
    },
    "/admin_audit_logs/{eventId}": {
      "schema": "AdminAuditRecord",
      "description": "Append-only administrative audit trail events."
    },
    "/ledger_entries/{entryId}": {
      "schema": "LedgerSnapshot",
      "description": "Immutable financial ledger entries restricted to verified administrators on write."
    },
    "/media_items/{mediaId}": {
      "schema": "ProtectedMediaItem",
      "description": "Creator media metadata with anti-self-approval moderation enforcement."
    },
    "/talent_progress/{userId}": {
      "schema": "TalentProgressSnapshot",
      "description": "Audited production gamification progress snapshot isolated from financial ledger entries."
    },
    "/test_audit/{docId}": {
      "schema": "TestAuditProbe",
      "description": "Diagnostic probe documents for validating Firestore connectivity and access control."
    }
  }
}
